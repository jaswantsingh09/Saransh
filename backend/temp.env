ANTHROPIC_API_KEY=api_key_here
GROQ_API_KEY=gapi_key_here
OPENAI_API_KEY=api_key_here

# --- Auth (internal-org Google sign-in) ---
# OAuth 2.0 client id the desktop app authenticates with.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# Comma-separated Google Workspace domains allowed to sign in (the hd claim).
# Leave blank only for local testing; set it in production.
ALLOWED_HOSTED_DOMAINS=yourcompany.com
# Secret used to sign session tokens. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime in hours (default 168 = 7 days).
JWT_EXP_HOURS=168

# --- Ingest / storage ---
# Directory where uploaded meeting audio is stored (the shared disk volume).
AUDIO_DIR=audio_store